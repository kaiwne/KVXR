pkgname=artcraft-launcher
version=0.19.2
revision=1
archs="x86_64"
short_desc="Unified launcher to install, update, and open Craft App Suite apps"
maintainer="Kaiwne <kaiwne@proton.me>"
license="Apache-2.0 OR MIT"
homepage="https://getartcraft.com/"
changelog="https://github.com/storytold/craft-launcher/releases"

# ------------------------------

depends="desktop-file-utils hicolor-icon-theme"
nostrip=yes
nopie=yes

# ------------------------------

distfiles="https://github.com/storytold/craft-launcher/releases/download/v${version}/artcraft-launcher-${version}-linux-x86_64.tar.gz"
checksum="39a9aeb77f85ab06d65540b194f1582ec8c26529f7e10a8c9d6c07ff2180b66d"

# ------------------------------

do_install() {
	vbin bin/artcraft-launcher

	vmkdir usr/share
	vcopy share/applications usr/share
	vcopy share/icons usr/share
	vcopy share/metainfo usr/share

	vlicense share/doc/artcraft-launcher/LICENSE-MIT
}
