# ------------------------------

depends="desktop-file-utils hicolor-icon-theme"
nostrip=yes
nopie=yes

# ------------------------------

distfiles="https://github.com/storytold/craft-launcher/releases/download/v${version}/artcraft-launcher-${version}-linux-x86_64.tar.gz"
checksum="512b3e11c8a27566dea6e4149693ca66fe3f08f6eac501471d5407b635a68342"

# ------------------------------

do_install() {
	vbin bin/artcraft-launcher

	vmkdir usr/share
	vcopy share/applications usr/share
	vcopy share/icons usr/share
	vcopy share/metainfo usr/share

	vlicense share/doc/artcraft-launcher/LICENSE-MIT
}
